DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=timesheet
DB_NAME=timesheet

ENVIRONMENT=development
LOG_LEVEL=debug

# CORS: comma-separated list of allowed origins, or ["*"] to allow all (dev only)
# CORS_ORIGINS=["https://yourfrontend.example.com"]

# JWT / Auth — change SECRET_KEY to a long random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
